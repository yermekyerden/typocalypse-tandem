  "info": {
    "title": "Typocalypse Backend API",
    "description": "REST API for Typocalypse terminal training app",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Provide access token as: Bearer <token>"
      }
    },
    "schemas": {
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "neo"
          },
          "email": {
            "type": "string",
            "example": "neo@zion.dev"
          },
          "password": {
            "type": "string",
            "example": "supersecure"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "7e393f8e-d5f1-4d47-84d4-a1a8759eb0df"
          },
          "username": {
            "type": "string",
            "example": "neo"
          },
          "firstName": {
            "type": "string",
            "example": ""
          },
          "lastName": {
            "type": "string",
            "example": ""
          },
          "email": {
            "type": "string",
            "example": "neo@zion.dev"
          },
          "avatarUrl": {
            "type": "object",
            "nullable": true,
            "example": null
          },
          "createdAt": {
            "type": "string",
            "example": "2026-03-04T10:35:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-03-04T10:35:00.000Z"
          }
        },
        "required": [
          "id",
          "username",
          "firstName",
          "lastName",
          "email",
          "avatarUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "AuthTokensResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access.payload.signature"
          },
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.signature"
          },
          "expiresAt": {
            "type": "string",
            "example": "2026-03-04T10:50:00.000Z"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresAt"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          },
          "tokens": {
            "$ref": "#/components/schemas/AuthTokensResponseDto"
          }
        },
        "required": [
          "user",
          "tokens"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "neo"
          },
          "password": {
            "type": "string",
            "example": "supersecure"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.signature"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateProfileRequestDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Thomas"
          },
          "lastName": {
            "type": "string",
            "example": "Anderson"
          }
        }
      },
      "PublicProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "7e393f8e-d5f1-4d47-84d4-a1a8759eb0df"
          },
          "username": {
            "type": "string",
            "example": "neo"
          },
          "firstName": {
            "type": "string",
            "example": "Thomas"
          },
          "lastName": {
            "type": "string",
            "example": "Anderson"
          },
          "avatarUrl": {
            "type": "object",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "id",
          "username",
          "firstName",
          "lastName",
          "avatarUrl"
        ]
      },
      "ChangePasswordRequestDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "oldPassword123"
          },
          "newPassword": {
            "type": "string",
            "example": "newPassword456"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "LessonOverviewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "ls-home"
          },
          "slug": {
            "type": "string",
            "example": "ls-home"
          },
          "title": {
            "type": "string",
            "example": "List home directory"
          },
          "order": {
            "type": "number",
            "example": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "locked",
              "active",
              "completed"
            ],
            "example": "active"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "order",
          "status"
        ]
      },
      "ModuleOverviewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cmd-basics"
          },
          "slug": {
            "type": "string",
            "example": "cmd-basics"
          },
          "title": {
            "type": "string",
            "example": "Command Line Basics"
          },
          "description": {
            "type": "string",
            "example": "Navigate directories, list contents, and read files with core shell commands."
          },
          "order": {
            "type": "number",
            "example": 1
          },
          "lessons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LessonOverviewDto"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "description",
          "order",
          "lessons"
        ]
      },
      "LearningOverviewResponseDto": {
        "type": "object",
        "properties": {
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModuleOverviewDto"
            }
          }
        },
        "required": [
          "modules"
        ]
      },
      "LessonDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "ls-home"
          },
          "moduleId": {
            "type": "string",
            "example": "cmd-basics"
          },
          "slug": {
            "type": "string",
            "example": "ls-home"
          },
          "title": {
            "type": "string",
            "example": "List home directory"
          },
          "order": {
            "type": "number",
            "example": 1
          },
          "theoryMarkdown": {
            "type": "string",
            "example": "The `ls` command prints files and folders in the current directory. By default you start in the home directory."
          },
          "taskDescription": {
            "type": "string",
            "example": "Print the list of files in your home directory."
          },
          "hints": {
            "example": [
              "Try `ls` first if you are not sure the file exists."
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "moduleId",
          "slug",
          "title",
          "order",
          "theoryMarkdown",
          "taskDescription"
        ]
      },
      "LearningLessonDetailResponseDto": {
        "type": "object",
        "properties": {
          "lesson": {
            "$ref": "#/components/schemas/LessonDetailDto"
          }
        },
        "required": [
          "lesson"
        ]
      }
    }
  }
}
